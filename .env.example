# Copy to .env for local development. Never commit the real .env file.
# All variables are prefixed INVENTORY_ and consumed by
# backend/app/config/settings.py — do not read os.environ anywhere else.

# --- Service ---
INVENTORY_SERVICE_NAME=server-inventory-api
INVENTORY_ENVIRONMENT=development

# --- HTTP ---
INVENTORY_HOST=0.0.0.0
INVENTORY_PORT=8080
# Comma-separated list of origins the frontend is served from.
INVENTORY_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- MongoDB ---
INVENTORY_MONGO_URI=mongodb://localhost:27017
INVENTORY_MONGO_DB=server_inventory
INVENTORY_MONGO_CONNECT_TIMEOUT_MS=5000
INVENTORY_MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
INVENTORY_MONGO_SOCKET_TIMEOUT_MS=10000
INVENTORY_MONGO_MAX_POOL_SIZE=100
INVENTORY_MONGO_MIN_POOL_SIZE=0

# --- Redis (ephemeral cache only; MongoDB is always the source of truth) ---
INVENTORY_REDIS_URI=redis://localhost:6379/0
INVENTORY_REDIS_CONNECT_TIMEOUT_SECONDS=2.0
INVENTORY_REDIS_SOCKET_TIMEOUT_SECONDS=2.0
INVENTORY_REDIS_MAX_CONNECTIONS=50
INVENTORY_CACHE_DEFAULT_TTL_SECONDS=300

# --- Pagination ---
INVENTORY_DEFAULT_PAGE_SIZE=50
INVENTORY_MAX_PAGE_SIZE=200
# Signs opaque keyset-pagination cursors. Override in production.
INVENTORY_CURSOR_SECRET=dev-insecure-cursor-secret-change-in-production

# --- Classification regex safety ---
INVENTORY_REGEX_MAX_PATTERN_LENGTH=200
INVENTORY_REGEX_MATCH_TIMEOUT_SECONDS=0.25

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
INVENTORY_LOG_LEVEL=INFO

# --- Metrics ---
INVENTORY_METRICS_ENABLED=true

# --- Collectors (tools/run_collector.py, not the API process) ---
# Per-request socket timeout when talking to a vendor manager.
INVENTORY_COLLECTOR_CONNECT_TIMEOUT_SECONDS=15.0

# Which servers a collector may ingest, as a regex matched against the
# server's name (`re.search`, so "starts with" is `^ocp`). A vendor
# manager holds the whole datacenter; this is what keeps the servers that
# are not this platform's out of the inventory entirely.
#
# Leave empty to collect everything. A non-matching server is never
# fetched, so it gets no document, no health state and no audit trail —
# this is *not* the UPI-vs-hosted distinction, which classification rules
# make over the servers that do get collected.
#
# Check it before trusting it:
#   uv run python -m tools.run_collector --manager-type UCS_CENTRAL --dry-run
INVENTORY_COLLECTOR_NAME_PATTERN=^ocp

# --- Vendor manager connections ---
#
# One endpoint plus one login per manager type, and that is the whole of
# a collector's connection config: there are no Manager documents to
# create and no secret directory to mount.
#
# UCS Manager is the one carve-out, and it is deliberate: it has a login
# but no endpoint, because the UCS Central collector discovers every
# domain's address at runtime rather than reading one from here. See the
# Cisco block below.
#
# Leaving a vendor blank simply means it has no collector to run.
# `tools/run_collector.py --manager-type X` on a blank or half-filled
# vendor exits with an error naming exactly which of these to set,
# rather than attempting a login that fails as "bad credentials".
#
# The IP values are bare hostnames or IP addresses, never URLs — each
# vendor SDK builds its own URL, and a scheme here produces a mangled
# one ("https://https://host:443"), so the collector rejects it up front.
#
# In Kubernetes these come from a Secret via envFrom; see the
# `collectors.*` blocks in deploy/helm/server-inventory/values.yaml.
# Never put a real password in a file that gets committed.

# Cisco — one collector, driven from UCS Central:
#
#   uv run python -m tools.run_collector --manager-type UCS_CENTRAL --dry-run
#
# It asks Central for the registered domains and their addresses
# (`computeSystem`) and for the service-profile names and the domain each
# belongs to (`lsServer`) — two queries, no matter how many domains. It
# then logs into each domain's own UCS Manager and reads that domain's
# inventory live, over the data path validated against a live UCS
# Platform Emulator in docs/adr/0009.
#
# So this needs FIVE values, not three: Central's endpoint and login, and
# a UCS Manager login. There is deliberately no INVENTORY_UCS_MANAGER_IP
# — Central reports every domain's address itself, from
# `ComputeSystem.address`, so an endpoint here would be a value nobody
# reads, and naming one domain would read as if that domain were special.

# Cisco UCS Central — the endpoint and login for Central itself.
INVENTORY_UCS_CENTRAL_IP=
INVENTORY_UCS_CENTRAL_USERNAME=
INVENTORY_UCS_CENTRAL_PASSWORD=

# Cisco UCS Manager — login only, no endpoint (see above). One account
# that authenticates against every registered domain; a domain that
# rejects it fails that domain alone and is logged, without aborting the
# rest of the run.
INVENTORY_UCS_MANAGER_USERNAME=
INVENTORY_UCS_MANAGER_PASSWORD=

# How many domains the collector talks to at once. Each domain costs a
# login plus ~9 queries regardless of how many servers it holds, and the
# domains are independent, so this bounds wall-clock time without
# bounding what gets collected.
INVENTORY_UCS_CENTRAL_DOMAIN_CONCURRENCY=4

# HPE OneView. No collector yet.
INVENTORY_ONEVIEW_IP=
INVENTORY_ONEVIEW_USERNAME=
INVENTORY_ONEVIEW_PASSWORD=

# Dell OpenManage Enterprise. No collector yet.
INVENTORY_OME_IP=
INVENTORY_OME_USERNAME=
INVENTORY_OME_PASSWORD=

# --- Cisco Intersight collector ---------------------------------------
#
#   uv run python -m tools.verify_intersight          # read-only probe
#   uv run python -m tools.run_collector --manager-type INTERSIGHT --dry-run
#
# The only collector that reaches this platform's 10,000-server target
# without qualification: every sub-resource is listed once for the whole
# estate and joined in memory, so a run costs on the order of a hundred
# requests regardless of fleet size. See
# docs/adr/0017-intersight-collector.md.
#
# THESE TWO ARE NOT A LOGIN. Intersight has no username/password path for
# its REST API - it signs every request with an API key. USERNAME is the
# API Key ID as shown in Settings > API Keys, and PASSWORD is that key's
# PEM private half, unencrypted. Both API key generations work: v2 is
# "BEGIN RSA PRIVATE KEY", v3 is "BEGIN EC PRIVATE KEY", and the
# collector picks the signing algorithm from the PEM header itself.
# Mint the key against a Read-Only role.
#
# There is no key file to mount: the PEM rides in this variable. Write it
# as one line with literal \n between the lines, or export it from a
# shell:
#
#   INVENTORY_INTERSIGHT_PASSWORD="$(cat ~/intersight-key.pem)"
#
# IP is "intersight.com" for the SaaS tenant, or the appliance FQDN. An
# AIR-GAPPED site cannot reach intersight.com at all and needs an on-prem
# Private Virtual Appliance; a *Connected* Virtual Appliance still calls
# home and does not help.
INVENTORY_INTERSIGHT_IP=
INVENTORY_INTERSIGHT_USERNAME=
INVENTORY_INTERSIGHT_PASSWORD=

# Which servers to collect, by how Intersight manages them. UCSM is
# deliberately absent: those servers are exactly the ones the UCS Central
# collector already owns, and collecting both makes one document's fields
# flip on whichever collector ran last. Add UCSM only for an estate whose
# UCS domains are not registered with UCS Central at all.
INVENTORY_INTERSIGHT_MANAGEMENT_MODES=Intersight,IntersightStandalone

# PEM bundle trusted in addition to the system store, for an on-prem
# appliance with an internal CA. Empty is correct for SaaS.
INVENTORY_INTERSIGHT_CA_BUNDLE=

# $top. 1000 is the API's documented maximum. Cisco publishes no rate
# limit, so the collector backs off on 429 rather than assuming one.
INVENTORY_INTERSIGHT_PAGE_SIZE=1000
INVENTORY_INTERSIGHT_READ_TIMEOUT_SECONDS=60
INVENTORY_INTERSIGHT_RUN_BUDGET_SECONDS=1800

# --- Standalone Redfish collector -------------------------------------
#
#   uv run python -m tools.run_collector --manager-type REDFISH_STANDALONE --dry-run
#
# The collector for machines no aggregator owns: not registered with UCS
# Central, Intersight, OneView or OpenManage, reached one BMC at a time
# over DMTF Redfish. Any conformant BMC works — a Cisco CIMC that
# Intersight cannot manage, an iDRAC, a current iLO. See
# docs/adr/0016-redfish-standalone-collector.md.
#
# There is deliberately no INVENTORY_REDFISH_IP: like UCS Manager, this
# has a login but no single endpoint. The endpoints are the hosts listed
# in the inventory file.
#
# NOTE: INVENTORY_COLLECTOR_NAME_PATTERN does NOT apply to this collector.
# A BMC does not know the server's `ocp4-...` name, so `^ocp` would
# discard every host you listed. The inventory file IS the filter — treat
# it as a review-gated artifact, because it decides where credentials go.

# The fleet list. A TOML file, or a directory of *.toml for a sharded
# estate. See docs/examples/redfish-inventory.example.toml.
INVENTORY_REDFISH_INVENTORY_FILE=/root/redfish-inventory.toml

# Named per-host logins. Optional: a fleet sharing one account needs only
# the two variables below. Most estates give each BMC its own account, in
# which case this is the normal path — see
# docs/examples/redfish-credentials.example.toml.
INVENTORY_REDFISH_CREDENTIALS_FILE=/root/redfish-credentials.toml

# The fleet-wide fallback, used by any host that resolves no other
# credential.
INVENTORY_REDFISH_USERNAME=
INVENTORY_REDFISH_PASSWORD=

# PEM bundle trusted in addition to the system store — an internal CA, or
# Dell's custom signing certificate. Empty means the system store alone,
# which correctly rejects a factory self-signed certificate. Turning
# verification off is per-host, in the inventory file, and requires a
# written reason; there is deliberately no global switch.
INVENTORY_REDFISH_CA_BUNDLE=
INVENTORY_REDFISH_TLS_MIN_VERSION=TLSv1_2

# Connect and read are split because they answer different questions.
# Connect bounds "is this host there at all" and should fail fast across a
# fleet with dead hosts in it; read bounds a BMC that answered but is
# slow. 30s is evidence-led: a documented iLO fleet failed at 3s and was
# fixed at 20s.
INVENTORY_REDFISH_CONNECT_TIMEOUT_SECONDS=10.0
INVENTORY_REDFISH_READ_TIMEOUT_SECONDS=30.0

# Total wall clock per host, and for the whole run. Neither socket
# timeout can bound these: a BMC that answers every packet slowly never
# trips one. The run budget must stay below the CronJob's
# activeDeadlineSeconds so the process reports what it collected instead
# of being killed with no summary.
INVENTORY_REDFISH_HOST_BUDGET_SECONDS=180.0
INVENTORY_REDFISH_RUN_BUDGET_SECONDS=3600.0

# BMCs read at once. Independent devices, so this is bounded by our own
# sockets and by how much management traffic the network tolerates.
INVENTORY_REDFISH_FLEET_CONCURRENCY=16

# Estate protection. A rejected login is never retried, and after this
# many DISTINCT hosts reject the same credential it is disabled for the
# rest of the run. The budget is the one that matters when every BMC has
# its own account — there the per-credential counters all sit at one
# while accounts lock one at a time. Both bound damage; neither can
# fully prevent lockout, since hosts are contacted concurrently.
INVENTORY_REDFISH_AUTH_FAILURE_THRESHOLD=3
INVENTORY_REDFISH_AUTH_FAILURE_BUDGET=10
