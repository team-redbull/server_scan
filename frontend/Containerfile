FROM registry.access.redhat.com/ubi9/nodejs-22:9.8 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM registry.access.redhat.com/ubi9/nginx-124:9.8 AS runtime
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/nginx.conf

EXPOSE 8080

# Required: the S2I base's own CMD prints a usage message instead. See deploy/README.md.
CMD ["nginx", "-g", "daemon off;"]
